<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tue–Fri 06:58 run (see StartCalendarInterval below). Install:

    cp scripts/local.booking-agent.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/local.booking-agent.plist

  This alone is NOT enough. A sleeping Mac runs it late, which for a 07:00:00
  release is the same as not running it. Pair with a scheduled wake:

    sudo pmset repeat wake MTWRFSU 06:55:00

  and leave the machine on AC power. On battery with the lid closed, Apple
  Silicon sleeps too deeply for the wake to be dependable.

  Starting at 06:58 means deadline_seconds in preferences.toml must be at
  least 240 — otherwise the poll loop gives up before inventory drops.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.booking-agent</string>

    <!--
      MUST be the Homebrew 3.14, not /usr/bin/python3. The system python is
      3.9.6 and has no tomllib, so config loading dies on import and the run
      fails before it does anything. launchd gives you a minimal environment,
      so every path here is absolute on purpose.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/python@3.14/bin/python3.14</string>
        <string>-m</string>
        <string>booking_agent.cli</string>
        <string>--backend</string>
        <string>live</string>
        <string>--login</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/you/Desktop/booking-agent</string>

    <!-- Tue–Fri 06:58. Tuesday hits the normal 07:00 release for prime slots;
         Wed–Fri are idempotent no-ops once booked, but catch a holiday-shifted
         release (e.g. Labor Day) that a Tuesday-only run would miss entirely.
         Monday is skipped — the target Saturday isn't in the 4-day window yet. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>58</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>58</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>58</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>58</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/you/Desktop/booking-agent/data/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/Desktop/booking-agent/data/launchd.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
